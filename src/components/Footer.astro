---
const currentYear = new Date().getFullYear();
---

<footer class="bg-pastel-blue/10 border-t border-pastel-blue/20 mt-16">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
      <!-- Brand -->
      <div class="reveal">
        <div class="flex items-center justify-center md:justify-start gap-3 mb-4">
          <div class="w-10 h-10 bg-pastel-blue rounded-full flex items-center justify-center text-white font-bold text-lg transition-transform duration-300 hover:scale-110 hover:rotate-12">
            A
          </div>
          <span class="text-xl font-extrabold text-pastel-text">Little Learners English</span>
        </div>
        <p class="text-pastel-text/70 leading-relaxed">
          Making English fun and accessible for young learners around the world.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="reveal stagger-1">
        <h3 class="font-bold text-pastel-text mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href={`${import.meta.env.BASE_URL}`} class="text-pastel-text/70 hover:text-pastel-blue transition-colors animated-underline">Home</a></li>
          <li><a href={`${import.meta.env.BASE_URL}about/`} class="text-pastel-text/70 hover:text-pastel-blue transition-colors animated-underline">About Us</a></li>
          <li><a href={`${import.meta.env.BASE_URL}lessons/`} class="text-pastel-text/70 hover:text-pastel-blue transition-colors animated-underline">Lessons</a></li>
          <li><a href={`${import.meta.env.BASE_URL}contact/`} class="text-pastel-text/70 hover:text-pastel-blue transition-colors animated-underline">Contact</a></li>
        </ul>
      </div>

      <!-- Social Placeholders -->
      <div class="reveal stagger-2">
        <h3 class="font-bold text-pastel-text mb-4">Follow Us</h3>
        <div class="flex gap-3 justify-center md:justify-start">
          <a href="#" class="magnetic w-10 h-10 bg-pastel-pink/30 rounded-full flex items-center justify-center hover:bg-pastel-pink/50 transition-all duration-300 hover:scale-110" aria-label="Facebook">
            <span class="text-sm font-bold text-pastel-text/60">f</span>
          </a>
          <a href="#" class="magnetic w-10 h-10 bg-pastel-purple/30 rounded-full flex items-center justify-center hover:bg-pastel-purple/50 transition-all duration-300 hover:scale-110" aria-label="Instagram">
            <span class="text-sm font-bold text-pastel-text/60">ig</span>
          </a>
          <a href="#" class="magnetic w-10 h-10 bg-pastel-blue/30 rounded-full flex items-center justify-center hover:bg-pastel-blue/50 transition-all duration-300 hover:scale-110" aria-label="YouTube">
            <span class="text-sm font-bold text-pastel-text/60">yt</span>
          </a>
        </div>
        <p class="text-pastel-text/50 text-sm mt-4">
          <!-- Placeholder: Add social media links -->
          Social links coming soon!
        </p>
      </div>
    </div>

    <div class="border-t border-pastel-blue/20 mt-8 pt-8 text-center text-pastel-text/50 text-sm">
      <p>&copy; {currentYear} Little Learners English. All rights reserved.</p>
    </div>
  </div>
</footer>
