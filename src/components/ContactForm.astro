<form class="space-y-6" onsubmit="event.preventDefault()">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <label for="name" class="block text-sm font-semibold text-pastel-text mb-2">Your Name</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="Enter your name"
        class="w-full px-4 py-3 rounded-xl border-2 border-pastel-blue/20 bg-white focus:border-pastel-blue focus:outline-none transition-colors"
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-semibold text-pastel-text mb-2">Email Address</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder="Enter your email"
        class="w-full px-4 py-3 rounded-xl border-2 border-pastel-blue/20 bg-white focus:border-pastel-blue focus:outline-none transition-colors"
      />
    </div>
  </div>

  <div>
    <label for="subject" class="block text-sm font-semibold text-pastel-text mb-2">Subject</label>
    <select
      id="subject"
      name="subject"
      class="w-full px-4 py-3 rounded-xl border-2 border-pastel-blue/20 bg-white focus:border-pastel-blue focus:outline-none transition-colors"
    >
      <option value="">Select a topic</option>
      <option value="enrollment">Enrollment Inquiry</option>
      <option value="lessons">Question About Lessons</option>
      <option value="pricing">Pricing Information</option>
      <option value="other">Other</option>
    </select>
  </div>

  <div>
    <label for="message" class="block text-sm font-semibold text-pastel-text mb-2">Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      placeholder="Tell us how we can help..."
      class="w-full px-4 py-3 rounded-xl border-2 border-pastel-blue/20 bg-white focus:border-pastel-blue focus:outline-none transition-colors resize-none"
    ></textarea>
  </div>

  <button
    type="submit"
    class="bg-pastel-blue text-white font-bold px-8 py-3 rounded-full shadow-md hover:shadow-lg hover:scale-105 transition-all duration-300"
  >
    Send Message
  </button>

  <p class="text-pastel-text/40 text-sm">
    <!-- Placeholder: Connect this form to a backend service -->
    This form is a placeholder. Connect it to your preferred form service.
  </p>
</form>
