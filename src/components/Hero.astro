---
interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
}

const { title, subtitle, ctaText, ctaHref } = Astro.props;
---

<section class="hero-parallax relative overflow-hidden bg-gradient-to-br from-pastel-blue/20 via-pastel-pink/10 to-pastel-purple/20 py-20 md:py-28 animate-gradient">
  <!-- Animated floating blobs -->
  <div class="parallax-blob absolute top-10 left-10 w-20 h-20 bg-pastel-yellow/40 rounded-full blur-xl animate-float" style="transition: transform 0.1s linear;"></div>
  <div class="parallax-blob absolute bottom-10 right-10 w-32 h-32 bg-pastel-green/30 rounded-full blur-xl animate-float-reverse" style="transition: transform 0.1s linear;"></div>
  <div class="parallax-blob absolute top-1/2 left-1/3 w-16 h-16 bg-pastel-pink/30 rounded-full blur-lg animate-float-slow" style="transition: transform 0.1s linear;"></div>

  <!-- Extra decorative morphing shapes -->
  <div class="absolute top-1/4 right-1/4 w-24 h-24 bg-pastel-purple/20 animate-morph blur-md"></div>
  <div class="absolute bottom-1/3 left-1/5 w-14 h-14 bg-pastel-blue/25 animate-morph blur-sm" style="animation-delay: -3s;"></div>

  <!-- Floating sparkle dots -->
  <div class="absolute top-[15%] left-[20%] w-2 h-2 bg-pastel-yellow rounded-full animate-bounce-soft" style="animation-delay: 0s;"></div>
  <div class="absolute top-[30%] right-[25%] w-1.5 h-1.5 bg-pastel-pink rounded-full animate-bounce-soft" style="animation-delay: 0.5s;"></div>
  <div class="absolute bottom-[20%] left-[60%] w-2.5 h-2.5 bg-pastel-green rounded-full animate-bounce-soft" style="animation-delay: 1s;"></div>
  <div class="absolute top-[60%] left-[10%] w-1.5 h-1.5 bg-pastel-purple rounded-full animate-bounce-soft" style="animation-delay: 1.5s;"></div>
  <div class="absolute top-[20%] right-[15%] w-2 h-2 bg-pastel-blue rounded-full animate-bounce-soft" style="animation-delay: 0.7s;"></div>

  <div class="max-w-6xl mx-auto px-6 sm:px-8 grid md:grid-cols-2 gap-12 items-center relative z-10">
    <div class="text-center md:text-left">
      <h1 class="hero-title text-4xl md:text-5xl lg:text-6xl font-extrabold text-pastel-text leading-tight mb-6">
        <span class="animate-shimmer">{title}</span>
      </h1>
      <p class="hero-subtitle text-lg md:text-xl text-pastel-text/70 leading-relaxed mb-8">
        {subtitle}
      </p>
      {ctaText && ctaHref && (
        <a
          href={ctaHref}
          class="hero-cta inline-block bg-pastel-blue text-white font-bold px-8 py-4 rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300 btn-ripple confetti-trigger animate-pulse-glow"
        >
          {ctaText}
        </a>
      )}
    </div>

    <!-- Animated image placeholder -->
    <div class="hero-image flex justify-center">
      <div class="w-full max-w-md aspect-square bg-pastel-blue/10 border-4 border-dashed border-pastel-blue/30 rounded-3xl flex items-center justify-center card-tilt hover:border-pastel-blue/50 transition-colors duration-500">
        <div class="text-center p-8">
          <div class="text-6xl mb-4 animate-wiggle inline-block">📚</div>
          <p class="text-pastel-text/40 font-semibold">Hero Image Placeholder</p>
          <p class="text-pastel-text/30 text-sm mt-1">Add your image here</p>
        </div>
      </div>
    </div>
  </div>
</section>
