---
interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
}

const { title, subtitle, ctaText, ctaHref } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-pastel-blue/20 via-pastel-pink/10 to-pastel-purple/20 py-20 md:py-28">
  <!-- Decorative shapes -->
  <div class="absolute top-10 left-10 w-20 h-20 bg-pastel-yellow/40 rounded-full blur-xl"></div>
  <div class="absolute bottom-10 right-10 w-32 h-32 bg-pastel-green/30 rounded-full blur-xl"></div>
  <div class="absolute top-1/2 left-1/3 w-16 h-16 bg-pastel-pink/30 rounded-full blur-lg"></div>

  <div class="max-w-6xl mx-auto px-6 sm:px-8 grid md:grid-cols-2 gap-12 items-center relative z-10">
    <div class="text-center md:text-left">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-pastel-text leading-tight mb-6">
        {title}
      </h1>
      <p class="text-lg md:text-xl text-pastel-text/70 leading-relaxed mb-8">
        {subtitle}
      </p>
      {ctaText && ctaHref && (
        <a
          href={ctaHref}
          class="inline-block bg-pastel-blue text-white font-bold px-8 py-4 rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300"
        >
          {ctaText}
        </a>
      )}
    </div>

    <!-- Image placeholder -->
    <div class="flex justify-center">
      <div class="w-full max-w-md aspect-square bg-pastel-blue/10 border-4 border-dashed border-pastel-blue/30 rounded-3xl flex items-center justify-center">
        <div class="text-center p-8">
          <div class="text-6xl mb-4">📚</div>
          <p class="text-pastel-text/40 font-semibold">Hero Image Placeholder</p>
          <p class="text-pastel-text/30 text-sm mt-1">Add your image here</p>
        </div>
      </div>
    </div>
  </div>
</section>
