---
interface Props {
  title: string;
  description: string;
  icon?: string;
  color?: 'blue' | 'pink' | 'green' | 'yellow' | 'purple';
  href?: string;
}

const { title, description, icon = '📖', color = 'blue', href } = Astro.props;

const colorMap = {
  blue: 'bg-pastel-blue/20 border-pastel-blue/30',
  pink: 'bg-pastel-pink/20 border-pastel-pink/30',
  green: 'bg-pastel-green/20 border-pastel-green/30',
  yellow: 'bg-pastel-yellow/20 border-pastel-yellow/30',
  purple: 'bg-pastel-purple/20 border-pastel-purple/30',
};

const iconBgMap = {
  blue: 'bg-pastel-blue/30',
  pink: 'bg-pastel-pink/30',
  green: 'bg-pastel-green/30',
  yellow: 'bg-pastel-yellow/30',
  purple: 'bg-pastel-purple/30',
};

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'block p-6 rounded-2xl border-2 card-tilt',
    colorMap[color],
    href && 'cursor-pointer',
  ]}
>
  <div class:list={['w-14 h-14 rounded-xl flex items-center justify-center text-2xl mb-4', iconBgMap[color]]}>
    <span class="animate-wiggle">{icon}</span>
  </div>
  <h3 class="text-xl font-bold text-pastel-text mb-2">{title}</h3>
  <p class="text-pastel-text/70 leading-relaxed">{description}</p>
</Tag>
